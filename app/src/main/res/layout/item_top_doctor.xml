<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="160dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    android:layout_margin="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#847ECD"
        android:padding="8dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivDoctorImage"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_doctor_placeholder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Reserve fixed height for name so RatingBar stays aligned -->
        <TextView
            android:id="@+id/tvDoctorName"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="Dr Neha\nDeshmukh"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#99FFFFFF"
            android:gravity="center"
            android:ellipsize="none"
            android:scrollHorizontally="false"
            android:singleLine="false"
            app:layout_constraintTop_toBottomOf="@id/ivDoctorImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <RatingBar
            android:id="@+id/rbDoctorRating"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:rating="4"
            android:scaleX="0.75"
            android:scaleY="0.75"
            app:layout_constraintTop_toBottomOf="@id/tvDoctorName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvDoctorCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textSize="10sp"
            android:textColor="#99FFFFFF"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/rbDoctorRating"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
