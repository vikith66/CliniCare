<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_background">

    <!-- Decorative Pink Circle (Top Right) -->
    <ImageView
        android:id="@+id/decorativePinkCircle"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="-30dp"
        android:src="@drawable/decorative_pink_circle"
        android:alpha="0.6"
        android:contentDescription="Decorative element" />

    <!-- Decorative Light Circle (Bottom Left) -->
    <ImageView
        android:id="@+id/decorativeLightCircle"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="-20dp"
        android:src="@drawable/decorative_light_circle"
        android:alpha="0.5"
        android:contentDescription="Decorative element" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            android:contentDescription="Back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Appointment History"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/profile_text_dark"
            android:gravity="center"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Clear All"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/clear_all_button_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:minWidth="80dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Main Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/bottomNavigationBar"
        android:padding="0dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_inbox_nav"
                    android:alpha="0.5"
                    android:contentDescription="Empty inbox" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Appointments Yet"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/profile_text_dark"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your appointment history will appear here"
                    android:textSize="14sp"
                    android:textColor="@color/profile_text_light"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh"
                    android:textColor="@color/white"
                    android:background="@drawable/save_button_background"
                    android:layout_marginTop="16dp"
                    android:padding="12dp" />

            </LinearLayout>

            <!-- Appointments List -->
            <LinearLayout
                android:id="@+id/appointmentsListLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Appointment items will be added here dynamically -->

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:paddingBottom="24dp"
        android:gravity="center_vertical">

        <!-- Home Button -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/nav_button_background"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_home_nav"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="12sp"
                android:textColor="@color/profile_text_light"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Inbox Button (Active) -->
        <LinearLayout
            android:id="@+id/navInbox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/nav_button_active_background"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_inbox_nav"
                android:contentDescription="Inbox" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inbox"
                android:textSize="12sp"
                android:textColor="@color/profile_text_light"
                android:layout_marginTop="6dp" />

            <!-- Active indicator dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/active_dot"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- User Button -->
        <LinearLayout
            android:id="@+id/navUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/nav_button_background"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_user_nav"
                android:contentDescription="User" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textSize="12sp"
                android:textColor="@color/profile_text_light"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
