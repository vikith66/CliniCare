<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradientbookappiontment">

    <!-- Back button -->
    <ImageView
        android:id="@+id/ivDoctorBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        android:contentDescription="Back"
        android:padding="4dp"
        android:src="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header -->
    <TextView
        android:id="@+id/tvDoctorHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:layout_marginStart="60dp"
        android:layout_marginTop="54dp"
        android:text="Doctor Details"
        android:textColor="#002C28"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@id/ivDoctorBack"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollDoctorDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivDoctorBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Doctor Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDoctorDetailImage"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/adddoctorbtn"
                    app:shapeAppearanceOverlay="@style/CircularImage"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="22dp">

                    <TextView
                        android:id="@+id/tvDoctorDetailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dr. NAME"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#002C28"/>

                    <TextView
                        android:id="@+id/tvDoctorDetailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Specialist"
                        android:textSize="14sp"
                        android:textColor="#002C28"/>

                    <TextView
                        android:id="@+id/tvDoctorDetailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="★ 5.0"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"
                        android:textColor="#206355"
                        android:background="@drawable/bg_rating"
                        android:padding="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- About Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvAboutHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textStyle="bold"
                    android:textColor="#002C28"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvAboutParagraph"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doctor about info goes here..."
                    android:textSize="12sp"
                    android:textColor="#002C28"/>
            </LinearLayout>

            <!-- Date RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDates"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:paddingRight="4dp"
                android:clipToPadding="false"
                android:scrollbars="horizontal"/>

            <!-- Divider line BELOW the date RecyclerView -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginBottom="8dp"
                android:background="#7AA19B"/>

            <!-- Time RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:scrollbars="none"/>


            <Button
                android:id="@+id/btnConfirmAppointment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Book Appointment"
                android:backgroundTint="#206355"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
